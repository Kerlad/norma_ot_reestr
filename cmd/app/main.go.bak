func formatSNILS(s string) string {
	s = strings.ReplaceAll(s, "-", "")
	s = strings.ReplaceAll(s, " ", "")
	if len(s) == 11 {
		return s[:3] + "-" + s[3:6] + "-" + s[6:9] + " " + s[9:]
	}
	return s
}

func sendToMintrud(xmlPath, key string) (string, error) {
	xmlData, err := os.ReadFile(xmlPath)
	if err != nil {
		return "", err
	}
	var buf bytes.Buffer
	zw := zip.NewWriter(&buf)
	f, _ := zw.Create("Data.xml")
	f.Write(xmlData)
	zw.Close()
	body := &bytes.Buffer{}
	w := multipart.NewWriter(body)
	part, _ := w.CreateFormFile("Data.olot", "Data.olot")
	part.Write(buf.Bytes())
	w.WriteField("ApiKey", key)
	w.WriteField("NeedSend", "false")
	w.Close()
	client := &http.Client{Timeout: 30 * time.Second}
	req, _ := http.NewRequest("POST", "https://edu.rosmintrud.ru/api/set/push", body)
	req.Header.Set("X-API-Key", key)
	req.Header.Set("Content-Type", w.FormDataContentType())
	resp, err := client.Do(req)
	if err != nil {
		return "", err
	}
	defer resp.Body.Close()
	b, _ := io.ReadAll(resp.Body)
	var res map[string]string
	json.Unmarshal(b, &res)
	if id, ok := res["setId"]; ok {
		return id, nil
	}
	return "", fmt.Errorf(string(b))
}

func addToJournal(setId, xmlPath string) {
	for _, w := range workers {
		e := JournalEntry{
			ID:           len(journal.Entries) + 1,
			LastName:     w.LastName,
			FirstName:   w.FirstName,
			MiddleName:  w.MiddleName,
			SNILS:        w.SNILS,
			Position:     w.Position,
			ProgramNum:  w.ProgramNum,
			ProgramTit:   programMap[w.ProgramNum],
			Date:         w.Date,
			ProtocolNum:  w.ProtocolNum,
			SetId:        setId,
			SendDate:     time.Now().Format("02.01.2006 15:04"),
			XMLPath:      xmlPath,
			Status:       "ожидает",
		}
		journal.Entries = append(journal.Entries, e)
	}
	saveJournal()
}

func updateJournal(setId string) {
	for i := range journal.Entries {
		if journal.Entries[i].SetId == setId {
			journal.Entries[i].Status = "получен"
		}
	}
	saveJournal()
}

func exportJournal() {
	p := filepath.Join(dataDir, "journal_"+time.Now().Format("20060102150405")+".csv")
	f, _ := os.Create(p)
	w := csv.NewWriter(f)
	w.Write([]string{"Дата", "SetId", "Фамилия", "Имя", "СНИЛС", "Прогр", "Статус"})
	for _, e := range journal.Entries {
		w.Write([]string{e.SendDate, e.SetId, e.LastName, e.FirstName, e.SNILS, e.ProgramNum, e.Status})
	}
	w.Flush()
	f.Close()
}