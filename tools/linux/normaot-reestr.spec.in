# DRAFT, NOT BUILT YET (L-06): needs rpmbuild on the target OS (RED OS / ALT). Check macro and
# dependency names on the image, then tighten the Requires. @VERSION@ is substituted by the build script.
Name:           normaot-reestr
Version:        @VERSION@
Release:        1
Summary:        Норма ОТ: Реестр обучения
License:        MIT
BuildArch:      x86_64
AutoReqProv:    no
Requires:       libxkbcommon-x11, xcb-util-cursor, xcb-util-image, xcb-util-keysyms, xcb-util-renderutil, xcb-util-wm, mesa-libEGL, fontconfig, dbus-libs

%description
Реестр обучения по охране труда и обмен данными с реестром Минтруда.

%install
mkdir -p %{buildroot}/opt/normaot-reestr %{buildroot}%{_bindir} %{buildroot}%{_datadir}/applications %{buildroot}%{_datadir}/pixmaps
cp -a %{_sourcedir}/normaot-reestr/. %{buildroot}/opt/normaot-reestr/
ln -s /opt/normaot-reestr/normaot-reestr %{buildroot}%{_bindir}/normaot-reestr
cp %{_sourcedir}/normaot-reestr.desktop %{buildroot}%{_datadir}/applications/
cp %{_sourcedir}/normaot-reestr.png %{buildroot}%{_datadir}/pixmaps/

%files
/opt/normaot-reestr
%{_bindir}/normaot-reestr
%{_datadir}/applications/normaot-reestr.desktop
%{_datadir}/pixmaps/normaot-reestr.png
